# 复制为 Next-k-protocol/.env.oi（本地开发）或写入 Railway 环境变量
# =====================
# 可选模块默认全关；币安核心 /api/binance/* 与箱体 /api/box/* 默认开。

# ── 服务端口 ─────────────────────────────────────────────────────
# PORT=8001

# ── 币安 API ─────────────────────────────────────────────────────
# BINANCE_API_KEY=your-binance-api-key
# BINANCE_API_SECRET=your-binance-api-secret
# BINANCE_TESTNET=false                # 仅选择测试网/主网，不控制是否下单

# 交易开关、入场类型、持仓上限、保证金/杠杆等由 next-k-api 信号控制。
# ORB 侧示例：ORB_LIVE_ENABLED=1

# ── 数据目录 ─────────────────────────────────────────────────────
# Railway 挂载 Volume 时通常为 /data
# DATA_DIR=/data

# ── 内嵌调度器（默认开启）─────────────────────────────────────────
# EMBED_SCHEDULER=1

# ── Next K 网格总控台（实现目录 vendor/wangge，Bitget）──────────────
# 默认关闭
WANGGE_ENABLED=0
WANGGE_REQUIRED=0
# WANGGE_PORT=8080
# API 密钥写在 vendor/wangge/.env（见 vendor/wangge/.env.example）

# ── HL 映仓台（API 前缀 /api/hl-short）────────────────────────────
# 默认关闭；开启：HL_DESK_ENABLED=1，跟单：HL_COPY_ENABLED=1
HL_DESK_ENABLED=0
HL_COPY_ENABLED=0
# Desk seats: watchlist = C+F only. Live C on main BITGET_*:
# HL_BITGET_LIVE=1
# HL_BITGET_DRY_RUN=0
# HL_BITGET_MODE=sub
# HL_BITGET_ENABLE_BOTS=bot_c
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_PASSPHRASE=

# ── clawby-quant（vendor/clawby_quant）────────────────────────────
# 默认关闭；开启：NEXT_K_CLAWBY_EMBED=1
NEXT_K_CLAWBY_EMBED=0
# CLAWBY_QUANT_PORT=8899
# CLAWBY_QUANT_URL=http://127.0.0.1:8899
# CLAWBY_QUANT_ROOT=   # default: vendor/clawby_quant
# CLAWBY_API_KEY=
# 币安：复用上方 BINANCE_API_KEY + BINANCE_API_SECRET 即可
# （sidecar 会把 BINANCE_API_SECRET 映射为 clawby 的 BINANCE_SECRET_KEY）

# ── 箱体突破（vendor/tradegenius_box，A股+币圈扫描）────────────────
# 默认开启；关掉：NEXT_K_BOX_ENABLED=0
NEXT_K_BOX_ENABLED=1
# 结果目录：$DATA_DIR/box_breakout/
# 前端 next-k-frontend/box.html 调 /api/box/*；生产请把前端域名加进 PROTOCOL_CORS_ORIGINS
